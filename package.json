{
  "name": "ticktick-waybar",
  "version": "0.2.0",
  "description": "A fast TickTick module for Waybar, driven by Walker.",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "check": "node --check src/*.mjs scripts/*.mjs test/*.mjs",
    "test": "node --test",
